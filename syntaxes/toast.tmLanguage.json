{
  "scopeName": "source.toast",
  "name": "Toast",
  "patterns": [
    {
      "include": "#imports"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],

  "repository": {
    "imports": {
      "patterns": [
        {
          "name": "meta.import.toast",
          "begin": "^(#require)\\s+",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.toast"
            }
          },
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.double.toast",
              "match": "\"[^\"]+\""
            },
            {
              "name": "string.quoted.other.lt-gt.include.c",
              "match": "<[^>]+>"
            }
          ]
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.toast",
          "match": "#(?!import).*",
          "captures": {
            "0": {
              "name": "comment.line.toast"
            }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.function.toast",
          "match": "\\bfunc\\b"
        },
        {
          "name": "keyword.control.toast",
          "match": "\\b(if|else|return|while|for|break|continue)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.toast",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.toast",
              "match": "\\\\[ntr\"\\\\]"
            },
            {
              "name": "constant.character.escape.toast",
              "match": "%[diouxXeEfFgGaAcspn%]"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.toast",
          "match": "\\b\\d+\\.?\\d*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.toast",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.toast",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.toast",
          "match": "(&|\\||\\^|<<|>>)"
        },
        {
          "name": "keyword.operator.assignment.toast",
          "match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.toast",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.toast",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
